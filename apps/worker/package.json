{
  "name": "@testpilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "setup:browsers": "bash scripts/setup.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@playwright/test": "^1.54.2",
    "@testpilot/ai-core": "workspace:*",
    "@testpilot/database": "workspace:*",
    "@testpilot/domain": "workspace:*",
    "@testpilot/security": "workspace:*",
    "@testpilot/test-compiler": "workspace:*",
    "@testpilot/test-ir": "workspace:*",
    "@testpilot/test-runtime": "workspace:*",
    "bullmq": "^5.58.0",
    "dotenv": "^17.2.1",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
