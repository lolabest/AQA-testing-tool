{
  "name": "@testpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/app.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@testpilot/ai-core": "workspace:*",
    "@testpilot/contracts": "workspace:*",
    "@testpilot/database": "workspace:*",
    "@testpilot/domain": "workspace:*",
    "@testpilot/security": "workspace:*",
    "@testpilot/test-compiler": "workspace:*",
    "@testpilot/test-ir": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
