# TestPilot AI — local development environment
# Copy to .env and adjust as needed. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://testpilot:testpilot@localhost:5432/testpilot?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-only-change-me-to-a-long-random-string-32chars
SESSION_TTL_SECONDS=86400

# Encryption (32-byte key hex for AES-256-GCM local development)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object storage (MinIO / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=testpilot
S3_SECRET_ACCESS_KEY=testpilotsecret
S3_BUCKET=testpilot-artifacts
S3_FORCE_PATH_STYLE=true

# Demo SUT
DEMO_SUT_URL=http://localhost:3002

# AI defaults (MockAiProvider for local demo — no external keys required)
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=mock-v1
# Optional real providers (leave empty for local demo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Playwright browsers
# Leave unset to use the default user cache (~/.cache/ms-playwright).
# Set to 0 only when you intentionally install browsers into node_modules.
# PLAYWRIGHT_BROWSERS_PATH=0

# Quality / safety
ALLOW_PRIVATE_NETWORK_TARGETS=true
SSRF_ALLOW_LOCALHOST=true
